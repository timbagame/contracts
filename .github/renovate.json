{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all", "schedule:daily"],
  "timezone": "America/Argentina/Buenos_Aires",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "anchor-spl 1.2.1's solana-v3 feature links the Token-2022 proof crates, which fail to link for sbpfv3. 1.2.1 only adds Solana v4 support, which litesvm doesn't use yet. The Anchor CLI stays on the same version as the crates.",
      "matchPackageNames": [
        "anchor-lang",
        "anchor-spl",
        "solana-foundation/anchor"
      ],
      "allowedVersions": "!/^v?1\\.2\\.1$/"
    },
    {
      "description": "litesvm 0.18 requires solana-rent ~4.4. Drop this once litesvm allows newer.",
      "matchDepNames": ["solana-rent"],
      "allowedVersions": "~4.4"
    },
    {
      "description": "Test SDK crates must match the versions litesvm uses. Bump them together with litesvm.",
      "matchDepNames": [
        "solana-instruction",
        "solana-keypair",
        "solana-loader-v3-interface",
        "solana-message",
        "solana-signer",
        "solana-transaction"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Surfpool 1.6.1 makes refund-race.test.ts fail with GameExpired on every run.",
      "matchPackageNames": ["solana-foundation/surfpool"],
      "allowedVersions": "!/^v?1\\.6\\.1$/"
    },
    {
      "description": "Foundry libraries follow release tags, never branch commits. The submodule (.gitmodules branch) and evm/foundry.lock move together in the grouped PR.",
      "matchFileNames": [".gitmodules", "evm/foundry.lock"],
      "versioning": "semver"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "anchor_version in Anchor.toml",
      "managerFilePatterns": ["/(^|/)Anchor\\.toml$/"],
      "matchStrings": ["anchor_version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "solana-foundation/anchor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "solana_version in Anchor.toml",
      "managerFilePatterns": ["/(^|/)Anchor\\.toml$/"],
      "matchStrings": ["solana_version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "anza-xyz/agave",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Solidity compiler in foundry.toml and contract pragmas. Tests use ^ so they need no updates.",
      "managerFilePatterns": [
        "/(^|/)foundry\\.toml$/",
        "/^evm/(src|script)/.+\\.sol$/"
      ],
      "matchStrings": [
        "solc_version = \"(?<currentValue>[^\"]+)\"",
        "pragma solidity (?<currentValue>\\d+\\.\\d+\\.\\d+);"
      ],
      "depNameTemplate": "solidity",
      "packageNameTemplate": "argotorg/solidity",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Foundry library tags and commits in foundry.lock",
      "managerFilePatterns": ["/(^|/)foundry\\.lock$/"],
      "matchStrings": [
        "\"lib/(?<depName>[^\"]+)\": \\{\\s*\"tag\": \\{\\s*\"name\": \"(?<currentValue>[^\"]+)\",\\s*\"rev\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://github.com/{{#if (equals depName 'forge-std')}}foundry-rs{{else}}OpenZeppelin{{/if}}/{{depName}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    }
  ],
  "git-submodules": { "enabled": true }
}
