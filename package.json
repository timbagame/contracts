{
  "name": "timba-contracts-tooling",
  "private": true,
  "type": "module",
  "description": "Repo-level scripts: coverage gates and mutation testing. The Solana client has its own package in solana/.",
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "minimatch@^10": "11.0.3",
    "qs": "6.17.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:check": "prettier scripts stryker.conf.mjs package.json tsconfig.json --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4"
