    "@codama/renderers-js": "2.4.0",
    "@eslint/js": "^10.0.1",
    "@solana/kit": "8.2.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@types/bun": "^1.4.0",
    "codama": "1.10.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "license": "BUSL-1.1",
