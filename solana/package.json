    "@solana/kit": "8.5.0",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "codama": "1.11.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
