{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "target": "es2020",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "lib": ["es2020"],
    "esModuleInterop": true
  }
}
